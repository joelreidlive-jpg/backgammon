{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backgammon",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // A 2-ply search needs far more than the 10 ms of CPU the free plan allows,
  // so the Workers Paid plan is a functional requirement, not a scaling one.
  "limits": {
    "cpu_ms": 60000
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH",
        "class_name": "MatchDO"
      }
    ]
  },
  // SQLite-backed from the start: switching storage backend later requires a
  // painful migration.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchDO"]
    }
  ],
  // A player's progress outlives any one match, so it cannot live in a match
  // Durable Object. The id identifies the database but grants no access, so it
  // is committed to keep deploys reproducible; local `wrangler dev` ignores it.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "backgammon",
      "database_id": "ad3994e7-f2ff-41b9-b0ae-2eee51574d98",
      "migrations_dir": "migrations"
    }
  ]
}
