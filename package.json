{
  "name": "backgammon",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @bg/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc --noEmit -p apps/api && tsc --noEmit -p apps/web",
    "lint": "eslint .",
    "dev:api": "pnpm --filter @bg/api dev",
    "dev:web": "pnpm --filter @bg/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.14.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.11"
  }
}
